   ],
   "source": [
    "s7 = pd.Series([1.2, np.nan, 3.4, np.nan, 5.6, 6.8])\n",
    "mean_value = s7.mean()\n",
    "print(\"Среднее значение:\", mean_value)\n",
    "s7_filled = s7.fillna(mean_value)\n",
    "print(\"Результат после замены NaN:\")\n",
    "print(s7_filled)"
   ]
